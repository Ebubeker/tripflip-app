# Gemini AI API Key (Required for AI summaries)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Amadeus API Credentials (Optional - uses mock data if not configured)
# Get credentials from: https://developers.amadeus.com/
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here

# Hotelbeds API Credentials (Optional - uses mock data if not configured)
# Get credentials from: https://developer.hotelbeds.com/
HOTELBEDS_API_KEY=your_hotelbeds_api_key_here
HOTELBEDS_API_SECRET=your_hotelbeds_api_secret_here
